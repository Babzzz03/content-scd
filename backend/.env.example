# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/postflow

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=another-long-random-secret-for-refresh-tokens
JWT_REFRESH_EXPIRE=30d

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── DeepSeek AI ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# ─── Encryption (32 hex chars = 16 bytes) ─────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_encryption_key_here_for_aes256

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Cloudinary (media storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE_MB=50

# ─── Automation ───────────────────────────────────────────────────────────────
# Proxy for residential IP rotation (optional, recommended for production)
# Format: http://user:pass@host:port
PROXY_URL=

# Browser sessions directory
SESSIONS_DIR=./automation/sessions

# Run browsers in headless mode (false recommended to avoid detection)
BROWSER_HEADLESS=false

# Minimum / maximum random delay between automation actions (ms)
AUTOMATION_DELAY_MIN=800
AUTOMATION_DELAY_MAX=3500

# Set false on a small hosted instance that should serve HTTP and receive
# webhooks but never run scraping. Chromium needs 400-600MB; the API needs 120MB.
ENABLE_JOBS=true

# Set false on a small hosted instance. It then runs only the jobs that need no
# browser (WhatsApp sending, follow-up drafting), so those keep working while
# your laptop is closed. Scraping waits for a machine with RAM.
ENABLE_BROWSER_JOBS=true

# ─── WhatsApp via WAHA ────────────────────────────────────────────────────────
# Local development: run deploy/docker-compose.waha.local.yml and use these.
# WAHA_API_KEY must match the value in the compose file exactly or every call 401s.
WAHA_URL=http://localhost:3002
WAHA_API_KEY=local-dev-key-change-me
WAHA_WEBHOOK_HMAC_KEY=
WAHA_WEBHOOK_URL=http://host.docker.internal:5000/api/whatsapp/webhook
WAHA_TIMEOUT_MS=15000
