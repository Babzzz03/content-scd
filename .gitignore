# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example

# Browser session state contains live auth cookies
**/automation/sessions/
**/sessions/

# ── Dependencies & build output ───────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
dist/
build/
*.tsbuildinfo

# ── Logs & runtime ────────────────────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/

# ── Local repo artefacts from the monorepo restructure ────────────────────────
.git-root-backup/
.git-content-scd/

# ── Local scratch ─────────────────────────────────────────────────────────────
*.tmp
