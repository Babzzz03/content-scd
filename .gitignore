# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example

# Browser session state contains live auth cookies
**/automation/sessions/
**/sessions/

# ── Dependencies & build output ───────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
dist/
build/
*.tsbuildinfo

# ── Logs & runtime ────────────────────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/

# ── Claude Code ───────────────────────────────────────────────────────────────
# settings.json is shared; settings.local.json is per-machine and may hold
# permissions specific to one developer's setup.
.claude/settings.local.json
.claude/*.local.json

# ── Local repo artefacts from the monorepo restructure ────────────────────────
.git-root-backup/
.git-content-scd/
.git-old-local-backup/

# ── Local scratch ─────────────────────────────────────────────────────────────
*.tmp
